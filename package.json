{
  "name": "dhamani",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-client-bundle.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "db:migrate": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file=.env.local db/migrate.ts",
    "db:reset": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file=.env.local db/migrate.ts --reset",
    "db:seed": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file=.env.local db/seed/seed.ts",
    "test:db": "node --env-file=.env.local node_modules/vitest/vitest.mjs run tests/db --testTimeout=60000",
    "db:import-hospitals": "node --experimental-strip-types --no-warnings=ExperimentalWarning --env-file=.env.local db/seed/import-hospitals.ts",
    "templates:md": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/templates-md.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@serwist/next": "^9.5.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "next": "15.5.29",
    "next-intl": "^4.14.9",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "serwist": "^9.5.13",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
