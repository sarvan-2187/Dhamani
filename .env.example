# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (server only, never NEXT_PUBLIC_). Use the pooled connection string.
DATABASE_URL=

APP_BASE_URL=http://localhost:3000
SESSION_SECRET=
CRON_SECRET=

WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=            # System User token, not the 24 h temporary one
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_BUSINESS_NUMBER=         # digits only, for wa.me links
WA_ALLOWLIST=               # comma-separated E.164 digits, max 5
WA_GRAPH_VERSION=v23.0
SIMULATION_MODE=true
COORDINATOR_EMAILS=        # e.g. admin@dhamani.in,coordinator1@dhamani.in
SUPER_ADMIN_EMAILS=        # subset of COORDINATOR_EMAILS, e.g. admin@dhamani.in

# Only for npm run db:import-hospitals (data.gov.in Blood Bank Directory)
DATA_GOV_IN_API_KEY=
